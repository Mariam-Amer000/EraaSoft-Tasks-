@model OrderWithFilterVM

@{
    ViewData["Title"] = "حجوزاتي";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">قائمة حجوزاتي</h2>
        <!-- نموذج البحث برقم الطلب -->
        <form asp-area="Customer" asp-controller="Order" asp-action="Index" method="get" class="d-flex gap-2">
            <input type="number" name="query" value="@Model.Query" class="form-control" placeholder="ابحث برقم الطلب..." />
            <button type="submit" class="btn btn-primary">بحث</button>
        </form>
    </div>

    @if (!Model.Orders.Any())
    {
        <div class="alert alert-secondary text-center p-5 rounded">
            <h4>لا توجد حجوزات سابقة</h4>
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">تصفح الأفلام والحجز الآن</a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>التاريخ</th>
                        <th>الإجمالي</th>
                        <th>حالة الطلب</th>
                        <th>حالة الدفع</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd hh:mm tt")</td>
                            <td class="text-success fw-bold">@order.TotalPrice.ToString("C")</td>
                            <td>
                                <span class="badge @(order.OrderStatus == OrderStatus.InProcessing ? "bg-success" : order.OrderStatus == OrderStatus.Pending ? "bg-warning" : "bg-danger")">
                                    @order.OrderStatus
                                </span>
                            </td>
                            <td>
                                <span class="badge @(order.PaymentStatus == PaymentStatus.Succussed ? "bg-success" : order.PaymentStatus == PaymentStatus.Refunded ? "bg-info" : "bg-secondary")">
                                    @order.PaymentStatus
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-area="Customer" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-eye"></i> التفاصيل
                                </a>
                                @if (order.OrderStatus != OrderStatus.Cancelled)
                                {
                                    <a asp-area="Customer" asp-controller="Order" asp-action="Refund" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('هل أنت تأكد من إلغاء الحجز واسترداد المبلغ؟');">
                                        إلغاء واسترداد
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- الـ Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-item" asp-area="Customer" asp-controller="Order" asp-action="Index" asp-route-page="@i" asp-route-query="@Model.Query">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>