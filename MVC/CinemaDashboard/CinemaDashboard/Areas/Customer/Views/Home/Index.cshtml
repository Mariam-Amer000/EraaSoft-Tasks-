@model IEnumerable<Movie>

@{
    ViewData["Title"] = "الأفلام المتاحة";
}

<div class="container my-4">
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body d-flex justify-content-between align-items-center py-3">
            <div>
                <a asp-area="Customer" asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark btn-lg position-relative rounded-pill px-4">
                    <i class="bi bi-cart3 me-2"></i> سلة الحجز

                    <!-- يمكن عرض عدد العناصر إذا توفر في ViewBag أو Model -->
                    @if (ViewBag.CartCount != null && ViewBag.CartCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @ViewBag.CartCount
                        </span>
                    }
                </a>
            </div>

        </div>
    </div>
    <h2 class="mb-4 text-center fw-bold">الأفلام المعروضة حالياً</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var movie in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="~/imgs/movies/MainImg/@movie.MainImg" class="card-img-top style-img" alt="@movie.Name" style="height: 350px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@movie.Name</h5>
                        <p class="card-text text-muted flex-grow-1">
                            @(movie.Description.Length > 100 ? movie.Description.Substring(0, 100) + "..." : movie.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-info text-dark">@movie.Category?.Name</span>
                            <span class="fw-bold text-success">@movie.Price.ToString("C")</span>
                        </div>
                        <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="btn btn-outline-primary w-100 mt-auto">
                            <i class="bi bi-info-circle me-1"></i> التفاصيل والحجز
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>