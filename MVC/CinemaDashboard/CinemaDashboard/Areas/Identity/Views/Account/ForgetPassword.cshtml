@model CinemaDashboard.ViewModel.ForgetPasswordVM

@{
    ViewData["Title"] = "ForgetPassword";
}


<div class="container">
    <h1>ForgetPassword</h1>

    <h4>ForgetPasswordVM</h4>
    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="ForgetPassword">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="EmailOrUserName" class="control-label"></label>
                    <input asp-for="EmailOrUserName" class="form-control" />
                    <span asp-validation-for="EmailOrUserName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Send" class="btn btn-primary my-3" />
                </div>
            </form>
        </div>
    </div>
    <div class="my-3">
        <a asp-action="Login">Back to Login</a>
    </div>
</div>


@section Scripts{
    <partial name="_ValidationScriptsPartial">
}
